// Overwriting a structural field that is still live (never moved or
// dropped) would silently leak it (`rfcs/0012`).
resource File {
    descriptor: i64,
}

resource Session {
    input: File,
    output: File,
}

func main() -> i64 {
    mutable session = Session {
        input: File { descriptor: 1 },
        output: File { descriptor: 2 },
    };
    session.input = File { descriptor: 3 };
    return 0;
}
