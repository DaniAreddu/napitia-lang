// INVALID: `main` calls a generic function requiring `Equal[T]` at a
// concrete `str`, but no extension of `Equal` for `str` exists anywhere
// in this program. Rejected as T0039 (Alpha 0.1.5, rfcs/0009).
protocol Equal[T] {
    func equal(left: T, right: T) -> bool;
}

extend Equal[i64] {
    func equal(left: i64, right: i64) -> bool {
        return left == right
    }
}

func pair_equal[T](a: T, b: T) -> bool uses Equal[T] {
    return Equal[T].equal(a, b)
}

func main() -> bool {
    return pair_equal[str]("a", "a")
}
