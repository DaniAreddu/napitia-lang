// INVALID: an ever-growing (never literally repeating) instantiation
// chain -- Wrap[T], Wrap[Box[T]], Wrap[Box[Box[T]]], ... never closes a
// literal cycle, but is exactly as unlayoutable as one. Detected
// immediately (the declaration Wrap recurs on its own active traversal
// path, regardless of its own current arguments), never a hang or a
// stack overflow, and never merely by hitting a nesting-depth budget
// (Alpha 0.1.4, rfcs/0008).
record Wrap[T] {
    inner: Wrap[Box[T]],
}

record Box[T] {
    payload: T,
}

func main() -> i64 {
    return 0
}
