// Generic variant matched exhaustively over its *instantiated* payload
// type: Maybe[bool]'s Some payload is checked as the closed, two-value
// bool space it actually is here, not the declaration's own unresolved
// T (Alpha 0.1.4, rfcs/0008).
variant Maybe[T] {
    Some(T),
    None,
}

func inspect(v: Maybe[bool]) -> i64 {
    return match v {
        Some(true) => 1,
        Some(false) => 2,
        None => 0,
    }
}

func main() -> i64 {
    return inspect(Maybe[bool].Some(true))
}
