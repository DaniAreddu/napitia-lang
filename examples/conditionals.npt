// if/else as an expression, while, and loop/break/continue
// (spec/0002).
func classify(n: i64) -> i64 {
    if n < 0 {
        return -1
    } else {
        if n == 0 {
            return 0
        } else {
            return 1
        }
    }
}

func main() -> i64 {
    mutable total = 0;
    mutable i = 0;
    while i < 10 {
        if i == 5 {
            i += 1;
            continue;
        }
        total += i;
        i += 1;
    }

    mutable extra = 0;
    loop {
        extra += 1;
        if extra == 3 {
            break;
        }
    }

    return total + extra + classify(total)
}
