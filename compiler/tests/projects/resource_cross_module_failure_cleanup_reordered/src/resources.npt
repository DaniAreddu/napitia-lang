public variant OpenError {
    Invalid,
}

public resource File {
    descriptor: i64,
}

public func open(descriptor: i64) -> File raises OpenError {
    if descriptor < 0 {
        raise OpenError.Invalid;
    }
    return File { descriptor: descriptor };
}

public func validate(descriptor: i64) -> unit raises OpenError {
    if descriptor > 100 {
        raise OpenError.Invalid;
    }
}

public func close(take file: File) -> i64 {
    value result = file.descriptor;
    drop file;
    return result;
}
