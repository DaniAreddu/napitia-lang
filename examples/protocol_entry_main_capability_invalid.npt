// INVALID: the executable entry function cannot declare capability
// requirements -- it has no caller to supply evidence from. Rejected
// as T0045 (Alpha 0.1.5, rfcs/0009).
protocol Equal[T] {
    func equal(left: T, right: T) -> bool;
}

extend Equal[i64] {
    func equal(left: i64, right: i64) -> bool {
        return left == right
    }
}

func main() -> bool uses Equal[i64] {
    return Equal[i64].equal(1, 1)
}
