// `drop <place>` destroys exactly one structural field (`rfcs/0012`),
// leaving its siblings and its parent's own remaining cleanup intact.
resource File {
    descriptor: i64,
}

resource Session {
    input: File,
    output: File,
}

func main() -> i64 {
    value session = Session {
        input: File { descriptor: 1 },
        output: File { descriptor: 2 },
    };
    value total = session.output.descriptor;
    // Destroys `session.input` only: `session.output` is untouched and
    // is destroyed by the structural drop of `session` below, followed
    // by that resource's own outer identity.
    drop session.input;
    drop session;
    return total;
}
