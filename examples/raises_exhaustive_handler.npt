variant FileError {
    Missing,
    PermissionDenied,
}

variant NetworkError {
    Timeout,
}

func fetch(mode: i64) -> i64 raises FileError, NetworkError {
    if mode == 0 {
        return 42;
    }
    if mode == 1 {
        raise FileError.Missing;
    }
    if mode == 2 {
        raise FileError.PermissionDenied;
    }
    raise NetworkError.Timeout;
}

func fetch_or_default(mode: i64) -> i64 {
    return handle fetch(mode) {
        success v => v,
        failure FileError.Missing => -1,
        failure FileError.PermissionDenied => -2,
        failure NetworkError.Timeout => -3,
    };
}

func main() -> i64 {
    return fetch_or_default(0) + fetch_or_default(1) + fetch_or_default(2) + fetch_or_default(3);
}
